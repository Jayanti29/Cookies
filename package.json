{
  "name": "cookies-platform",
  "version": "1.0.0",
  "description": "COOKIES - Consumer digital-safety platform. Check Before You Trust.",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "digital-safety",
    "consumer-protection",
    "dark-patterns",
    "phishing",
    "scam-detection",
    "gemini-ai",
    "firebase",
    "react"
  ],
  "author": "Jayanti29",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jayanti29/Cookies.git"
  }
}
